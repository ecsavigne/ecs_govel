# port bin is gofiles/project_file/app.env -> PORTS
PORT_EXEC=11301 
# name of service
SERVICE_NAME=name_service # (APP_NAME in gofiles/project_file/app.env)

# name of external net
DOCKER_EXTERNAL_NETWORK=my_whatsmeow_whatsmeow

CMD=./build.sh

#file execute exemple /app/Binary/file1 && /app/Binary/file2
EXECs=/app/Binary/${SERVICE_NAME}${PORT_EXEC}

SUPERVISOR_CONFIG="rm -f /var/run/supervisor.sock && supervisord -c /etc/supervisor/supervisord.conf"
TAIL="tail -f /var/log/${SERVICE_NAME}/logs.log"
MY_CMD="${CMD} && ${SUPERVISOR_CONFIG} && sleep 5 && ${TAIL}"