# port bin is gofiles/project_file/app.env -> PORTS
PORT_EXEC=11301 
# name of service
SERVICE_NAME=name_service
# name of external net
DOCKER_EXTERNAL_NETWORK=my_whatsmeow_whatsmeow

CMD=./build.sh

#file execute exemple /app/Binary/file1 && /app/Binary/file2
EXECs=/app/Binary/${SERVICE_NAME}${PORT_EXEC}

MY_CMD="${CMD} && ${EXECs} && sleep 5; tail -f /var/log/${SERVICE_NAME}/logs.log"